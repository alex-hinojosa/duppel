{
  "name": "phantomgrid-e2e",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:check": "node esbuild.config.mjs && git diff --exit-code anti-fingerprint.js",
    "build:chrome": "node esbuild.config.mjs chrome",
    "build:firefox": "node esbuild.config.mjs firefox",
    "build:all": "node esbuild.config.mjs all",
    "setup": "npm install && npx playwright install chromium",
    "test": "npx playwright test --project=local --project=rotation",
    "test:local": "npx playwright test --project=local",
    "test:rotation": "npx playwright test --project=rotation",
    "test:external": "npx playwright test --project=external",
    "test:all": "npx playwright test",
    "test:report": "npx playwright show-report",
    "test:benchmark": "mkdir -p benchmark-results && npx playwright test --project=external --reporter=json > benchmark-results/benchmark-report.json",
    "test:baseline": "npx playwright test --project=baseline",
    "test:investigate": "npx playwright test --project=external -g 'Canvas Extraction Investigation'"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "esbuild": "^0.28.0"
  },
  "version": "1.0.0",
  "description": "",
  "main": "anti-fingerprint.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-hinojosa/phantomgrid.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/alex-hinojosa/phantomgrid/issues"
  },
  "homepage": "https://github.com/alex-hinojosa/phantomgrid#readme"
}
